---
import { Header } from '../components/Header'
import { Footer } from '../components/Footer'
import ThemeInit from '../components/ThemeInit.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'
import '../styles/global.css'
import { Container } from '../components/ui/container'
import { getCollection, type CollectionEntry } from 'astro:content'

interface Props {
  title: string
}

const { title } = Astro.props

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => {
  return data.visibility === 'visible'
})

const sortedPosts = posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => Temporal.PlainDate.compare(
  Temporal.PlainDate.from(b.data.pubDate),
  Temporal.PlainDate.from(a.data.pubDate),
))

const allPosts = sortedPosts.map((post: CollectionEntry<'blog'>) => ({
  title: post.data.title,
  slug: post.id.replace(/^src\/content\/blog\//, '').replace(/\/index\.mdx$/, '').replace(/\.mdx?$/, ''),
  description: post.data.description,
  pubDate: post.data.pubDate.toString(),
  labels: post.data.labels,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {title}
      {' '}
      |
      {' '}
      {SITE_TITLE}
    </title>
    <ThemeInit />
  </head>
  <body class="flex min-h-screen flex-col transition-colors duration-300">
    <Header client:load allPosts={allPosts} currentPath={Astro.url.pathname} />

    <main class="w-full min-w-0 flex-1 py-8 md:py-12">
      <Container>
        <slot />
      </Container>
    </main>

    <Footer client:only="react" />
  </body>
</html>
