---
import { getCollection, type CollectionEntry } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import { HomeFeed } from '../components/ui/HomeFeed'

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog'))
  .filter((post: CollectionEntry<'blog'>) => {
    if (import.meta.env.PROD) {
      return post.data.visibility === 'visible'
    }
    return true
  })
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => Temporal.PlainDate.compare(
    Temporal.PlainDate.from(b.data.pubDate),
    Temporal.PlainDate.from(a.data.pubDate),
  ));
---

<Layout title="Home">
  <HomeFeed
    posts={posts.map(post => ({
      description: post.data.description,
      href: `/blog/${post.id.replace(/^src\/content\/blog\//, '').replace(/\/index\.mdx$/, '').replace(/\.mdx?$/, '')}/`,
      labels: post.data.labels,
      pubDate: post.data.pubDate,
      title: post.data.title,
    }))}
    client:load
  />
</Layout>
