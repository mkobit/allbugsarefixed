{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/openspec-validate.ts\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun scripts/verify-versions.ts)",
      "Bash(bun run lint *)",
      "Bash(bun run openspec:validate *)",
      "Bash(bun run typecheck *)",
      "Bash(bun run test *)",
      "Bash(bun run coverage *)",
      "Bash(bun run build *)",
      "Bash(bun run test:e2e *)"
    ]
  }
}
