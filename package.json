{
  "name": "allbugsarefixed",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "bun@1.4.3",
  "main": "index.js",
  "repository": "git@github.com:mkobit/allbugsarefixed.git",
  "license": "MIT",
  "scripts": {
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "lint": "eslint . --ext .js,.ts,.tsx,.astro,.mdx --cache",
    "lint:fix": "eslint . --ext .js,.ts,.tsx,.astro,.mdx --cache --fix",
    "typecheck": "astro check && tsc --noEmit",
    "test": "bun test src",
    "coverage": "bun test src --coverage",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --grep @live-safe",
    "verify": "bun run verify:versions && bun run verify:blog",
    "verify:versions": "bun scripts/verify-versions.ts",
    "verify:blog": "bun scripts/verify-blog-structure.ts",
    "new-idea": "bun scripts/new-idea.ts",
    "openspec:validate": "openspec validate --all",
    "changelog:generate": "bun scripts/generate-changelog.ts",
    "check:sbx-env": "bun scripts/check-sbx-env.ts",
    "purge-scratch": "bun scripts/purge-scratch.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@tanstack/react-table": "^9.2.4",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "astro": "7.3.5",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fuse.js": "^7.5.0",
    "katex": "^0.18.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "pigeon-maps": "^0.22.1",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remeda": "^2.50.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.14.1",
    "@iarna/toml": "^2.2.5",
    "@playwright/test": "^1.63.0",
    "@shikijs/transformers": "^4.4.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "astro-eslint-parser": "^3.2.0",
    "d3-dsv": "^3.0.1",
    "dompurify": "^3.4.16",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sort-keys": "^2.3.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "jsonc-parser": "^3.3.1",
    "mdast": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "playwright": "^1.63.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-reading-time": "^2.1.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unist": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "zod": "^4.6.5"
  }
}
